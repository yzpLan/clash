name: yzp 自定义分流
desc: 保留机场节点，使用 ACL4SSR Smart Lite 分组与规则

mode: rule

rule-providers:
  MyDirect:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/yzpLan/clash/refs/heads/main/MyDirect.list
    interval: 86400
  MyEmby:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/yzpLan/clash/refs/heads/main/MyEmby.list
    interval: 86400
  MyProxy:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/yzpLan/clash/refs/heads/main/MyProxy.list
    interval: 86400
  BanAD:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/BanAD.list
    interval: 86400
  Telegram:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Telegram.list
    interval: 86400
  AI:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/AI.list
    interval: 86400
  YouTube:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/YouTube.list
    interval: 86400
  ProxyGFWlist:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ProxyGFWlist.list
    interval: 86400
  ChinaDomain:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/ChinaDomain.list
    interval: 86400

proxy-groups: #!replace
- name: 🚀 节点选择
  type: select
  proxies:
  - ♻️ 自动选择
  - 📌 手动切换
  - 🇭🇰 香港节点
  - 🇯🇵 日本节点
  - 🇺🇲 美国节点
  - 🇸🇬 狮城节点
  - 🇨🇳 台湾节点
  - 🇰🇷 韩国节点
  - DIRECT
- name: 📌 手动切换
  type: select
  include-all: true
- name: ♻️ 自动选择
  type: url-test
  include-all: true
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
- name: 🎬 EMBY影院
  type: select
  proxies:
  - 🚀 节点选择
  - 📌 手动切换
  - 🇭🇰 香港节点
  - 🇯🇵 日本节点
  - 🇺🇲 美国节点
  - 🇸🇬 狮城节点
  - 🇨🇳 台湾节点
  - 🇰🇷 韩国节点
  - DIRECT
- name: 📲 电报消息
  type: select
  proxies:
  - 🚀 节点选择
  - 📌 手动切换
  - 🇭🇰 香港节点
  - 🇯🇵 日本节点
  - 🇺🇲 美国节点
  - 🇸🇬 狮城节点
  - 🇨🇳 台湾节点
  - 🇰🇷 韩国节点
  - DIRECT
- name: 💬 Ai平台
  type: select
  proxies:
  - 🚀 节点选择
  - 📌 手动切换
  - 🇺🇲 美国节点
  - 🇯🇵 日本节点
  - 🇸🇬 狮城节点
  - 🇭🇰 香港节点
  - 🇨🇳 台湾节点
  - 🇰🇷 韩国节点
  - DIRECT
- name: 📹 油管视频
  type: select
  proxies:
  - 🚀 节点选择
  - 📌 手动切换
  - 🇭🇰 香港节点
  - 🇯🇵 日本节点
  - 🇺🇲 美国节点
  - 🇸🇬 狮城节点
  - 🇨🇳 台湾节点
  - 🇰🇷 韩国节点
  - DIRECT
- name: 🎯 全球直连
  type: select
  proxies:
  - DIRECT
  - 🚀 节点选择
- name: 🛑 广告拦截
  type: select
  proxies:
  - REJECT
  - DIRECT
- name: 🐟 漏网之鱼
  type: select
  proxies:
  - 🚀 节点选择
  - DIRECT
- name: 🇭🇰 香港节点
  type: url-test
  include-all: true
  filter: 香港|港|HK|Hong Kong|HongKong|hongkong
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
- name: 🇯🇵 日本节点
  type: url-test
  include-all: true
  filter: 日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
- name: 🇺🇲 美国节点
  type: url-test
  include-all: true
  filter: 美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 150
- name: 🇸🇬 狮城节点
  type: url-test
  include-all: true
  filter: 新加坡|坡|狮城|SG|Singapore
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
- name: 🇨🇳 台湾节点
  type: url-test
  include-all: true
  filter: 台|新北|彰化|TW|Taiwan
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50
- name: 🇰🇷 韩国节点
  type: url-test
  include-all: true
  filter: KR|Korea|KOR|首尔|韩|韓
  url: https://www.gstatic.com/generate_204
  interval: 300
  tolerance: 50

rules: #!replace
  - RULE-SET,MyDirect,🎯 全球直连
  - RULE-SET,MyEmby,🎬 EMBY影院
  - RULE-SET,MyProxy,🚀 节点选择
  - RULE-SET,BanAD,🛑 广告拦截
  - RULE-SET,Telegram,📲 电报消息
  - RULE-SET,AI,💬 Ai平台
  - RULE-SET,YouTube,📹 油管视频
  - RULE-SET,ProxyGFWlist,🚀 节点选择
  - RULE-SET,ChinaDomain,🎯 全球直连
  - GEOIP,CN,🎯 全球直连
  - MATCH,🐟 漏网之鱼
